# Activate SSI in the default Nginx server block.
echo "Enabling SSI in Nginx configuration..."
sed -i '/^\s*server\s*{/a \ \ \ \ ssi on;' /etc/nginx/nginx.conf

# Enable and start the Nginx service
echo "Starting and enabling Nginx service..."
systemctl enable nginx
systemctl start nginx